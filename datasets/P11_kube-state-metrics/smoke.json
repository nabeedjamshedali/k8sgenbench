{
  "checks": [
    {"name": "healthz", "target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8080},
     "method": "GET", "path": "/healthz", "expect_status": 200},
    {"name": "readyz", "target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8081},
     "method": "GET", "path": "/readyz", "expect_status": 200, "retry_seconds": 60},
    {"name": "pod-metrics", "target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8080},
     "method": "GET", "path": "/metrics", "expect_status": 200, "expect_body": "kube_pod_info", "retry_seconds": 60},
    {"name": "node-metrics", "target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8080},
     "method": "GET", "path": "/metrics", "expect_status": 200, "expect_body": "kube_node_info"},
    {"name": "telemetry-metrics", "target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8081},
     "method": "GET", "path": "/metrics", "expect_status": 200, "expect_body": "kube_state_metrics_list_total"}
  ],
  "d6_target": {"image": "registry.k8s.io/kube-state-metrics/kube-state-metrics", "port": 8080, "path": "/metrics"}
}
