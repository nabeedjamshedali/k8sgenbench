STGRES_DB\n            - name: POSTGRES_NON_ROOT_USER\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_USER\n            - name: POSTGRES_NON_ROOT_PASSWORD\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_PASSWORD\n            - name: PGDATA\n              value: /var/lib/postgresql/data/pgdata\n          ports:\n            - containerPort: 5432\n              name: postgres\n          resources:\n            requests:\n              cpu: 250m\n              memory: 256Mi\n            limits:\n              cpu: 1000m\n              memory: 1Gi\n          securityContext:\n            allowPrivilegeEscalation: false\n            seccompProfile:\n              type: RuntimeDefault\n          startupProbe:\n            exec:\n              command:\n                - sh\n                - -c\n                - pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"\n            periodSeconds: 10\n            failureThreshold: 30\n          livenessProbe:\n            exec:\n              command:\n                - sh\n                - -c\n                - pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"\n            periodSeconds: 10\n            failureThreshold: 3\n            timeoutSeconds: 5\n          readinessProbe:\n            exec:\n              command:\n                - sh\n                - -c\n                - pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"\n            periodSeconds: 10\n            failureThreshold: 3\n          volumeMounts:\n            - name: db-storage\n              mountPath: /var/lib/postgresql/data\n            - name: init-script\n              mountPath: /docker-entrypoint-initdb.d/init-data.sh\n              subPath: init-data.sh\n      volumes:\n        - name: init-script\n          configMap:\n            name: postgres-init-script\n            defaultMode: 493\n  volumeClaimTemplates:\n    - metadata:\n        name: db-storage\n      spec:\n        accessModes:\n          - ReadWriteOnce\n        resources:\n          requests:\n            storage: 5Gi\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: n8n\nspec:\n  selector:\n    app: n8n\n  ports:\n    - name: http\n      port: 5678\n      targetPort: 5678\n    - name: runner-broker\n      port: 5679\n      targetPort: 5679\n---\napiVersion: apps/v1\nkind: StatefulSet\nmetadata:\n  name: n8n\nspec:\n  serviceName: n8n\n  replicas: 1\n  selector:\n    matchLabels:\n      app: n8n\n  template:\n    metadata:\n      labels:\n        app: n8n\n    spec:\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 1000\n        runAsGroup: 1000\n        fsGroup: 1000\n      containers:\n        - name: n8n\n          image: \"docker.n8n.io/n8nio/n8n:2.43.5\"\n          env:\n            - name: DB_TYPE\n              value: postgresdb\n            - name: DB_POSTGRESDB_HOST\n              value: postgres\n            - name: DB_POSTGRESDB_PORT\n              value: \"5432\"\n            - name: DB_POSTGRESDB_DATABASE\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_DB\n            - name: DB_POSTGRESDB_USER\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_USER\n            - name: DB_POSTGRESDB_PASSWORD\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_PASSWORD\n            - name: N8N_RUNNERS_MODE\n              value: external\n            - name: N8N_RUNNERS_AUTH_TOKEN\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: RUNNERS_AUTH_TOKEN\n            - name: N8N_RUNNERS_BROKER_LISTEN_ADDRESS\n              value: 0.0.0.0\n  