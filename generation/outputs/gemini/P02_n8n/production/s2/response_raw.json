              "text": "```yaml\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: n8n\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: postgres-init-script\n  namespace: n8n\ndata:\n  init-data.sh: |\n    #!/bin/bash\n    set -e;\n\n    if [ -n \"${POSTGRES_NON_ROOT_USER:-}\" ] && [ -n \"${POSTGRES_NON_ROOT_PASSWORD:-}\" ]; then\n    \tpsql -v ON_ERROR_STOP=1 --username \"$POSTGRES_USER\" --dbname \"$POSTGRES_DB\" <<-EOSQL\n    \t\tCREATE USER ${POSTGRES_NON_ROOT_USER} WITH PASSWORD '${POSTGRES_NON_ROOT_PASSWORD}';\n    \t\tGRANT ALL PRIVILEGES ON DATABASE ${POSTGRES_DB} TO ${POSTGRES_NON_ROOT_USER};\n    \t\tGRANT CREATE ON SCHEMA public TO ${POSTGRES_NON_ROOT_USER};\n    \tEOSQL\n    else\n    \techo \"SETUP INFO: No Environment variables given!\"\n    fi\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: n8n-config\n  namespace: n8n\ndata:\n  POSTGRES_USER: \"changeUser\"\n  POSTGRES_DB: \"n8n\"\n  POSTGRES_NON_ROOT_USER: \"changeUser\"\n  PGDATA: \"/var/lib/postgresql/data/pgdata\"\n  DB_TYPE: \"postgresdb\"\n  DB_POSTGRESDB_HOST: \"postgres\"\n  DB_POSTGRESDB_PORT: \"5432\"\n  N8N_RUNNERS_MODE: \"external\"\n  N8N_RUNNERS_BROKER_LISTEN_ADDRESS: \"0.0.0.0\"\n  N8N_RUNNERS_TASK_BROKER_URI: \"http://n8n:5679\"\n---\napiVersion: v1\nkind: Secret\nmetadata:\n  name: n8n-secret\n  namespace: n8n\ntype: Opaque\nstringData:\n  POSTGRES_PASSWORD: \"changePassword\"\n  POSTGRES_NON_ROOT_PASSWORD: \"changePassword\"\n  RUNNERS_AUTH_TOKEN: \"changeRunnerAuthToken\"\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: postgres-pvc\n  namespace: n8n\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 10Gi\n---\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: n8n-pvc\n  namespace: n8n\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 10Gi\n---\napiVersion: apps/v1\nkind: StatefulSet\nmetadata:\n  name: postgres\n  namespace: n8n\nspec:\n  serviceName: postgres\n  replicas: 1\n  selector:\n    matchLabels:\n      app: postgres\n  template:\n    metadata:\n      labels:\n        app: postgres\n    spec:\n      containers:\n        - name: postgres\n          image: postgres:18\n          imagePullPolicy: IfNotPresent\n          env:\n            - name: POSTGRES_USER\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: POSTGRES_USER\n            - name: POSTGRES_DB\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: POSTGRES_DB\n            - name: POSTGRES_NON_ROOT_USER\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: POSTGRES_NON_ROOT_USER\n            - name: PGDATA\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: PGDATA\n            - name: POSTGRES_PASSWORD\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_PASSWORD\n            - name: POSTGRES_NON_ROOT_PASSWORD\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_PASSWORD\n          ports:\n            - containerPort: 5432\n              name: postgres\n          volumeMounts:\n            - name: postgres-data\n              mountPath: /var/lib/postgresql/data\n            - name: init-script\n              mountPath: /docker-entrypoint-initdb.d/init-data.sh\n              subPath: init-data.sh\n          readinessProbe:\n            exec:\n              command:\n                - sh\n                - -c\n                - pg_isready -h localhost -U ${POSTGRES_USER} -d ${POSTGRES_DB}\n            initialDelaySeconds: 5\n            periodSeconds: 5\n            timeoutSeconds: 5\n          livenessProbe:\n            exec:\n              command:\n                - sh\n                - -c\n                - pg_isready -h localhost -U ${POSTGRES_USER} -d ${POSTGRES_DB}\n            initialDelaySeconds: 15\n            periodSeconds: 10\n            timeoutSeconds: 5\n          resources:\n            requests:\n              cpu: 250m\n              memory: 256Mi\n            limits:\n              cpu: 1000m\n              memory: 1Gi\n      volumes:\n        - name: postgres-data\n          persistentVolumeClaim:\n            claimName: postgres-pvc\n        - name: init-script\n          configMap:\n            name: postgres-init-script\n            defaultMode: 0755\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: postgres\n  namespace: n8n\nspec:\n  ports:\n    - port: 5432\n      targetPort: 5432\n      name: postgres\n  selector:\n    app: postgres\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: n8n\n  namespace: n8n\nspec:\n  replicas: 1\n  strategy:\n    type: Recreate\n  selector:\n    matchLabels:\n      app: n8n\n  template:\n    metadata:\n      labels:\n        app: n8n\n    spec:\n      containers:\n        - name: n8n\n          image: docker.n8n.io/n8nio/n8n:2.43.5\n          imagePullPolicy: IfNotPresent\n          env:\n            - name: DB_TYPE\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: DB_TYPE\n            - name: DB_POSTGRESDB_HOST\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: DB_POSTGRESDB_HOST\n            - name: DB_POSTGRESDB_PORT\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: DB_POSTGRESDB_PORT\n            - name: DB_POSTGRESDB_DATABASE\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: POSTGRES_DB\n            - name: DB_POSTGRESDB_USER\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: POSTGRES_NON_ROOT_USER\n            - name: DB_POSTGRESDB_PASSWORD\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: POSTGRES_NON_ROOT_PASSWORD\n            - name: N8N_RUNNERS_MODE\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: N8N_RUNNERS_MODE\n            - name: N8N_RUNNERS_BROKER_LISTEN_ADDRESS\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: N8N_RUNNERS_BROKER_LISTEN_ADDRESS\n            - name: N8N_RUNNERS_AUTH_TOKEN\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: RUNNERS_AUTH_TOKEN\n          ports:\n            - containerPort: 5678\n              name: http\n            - containerPort: 5679\n              name: runner-broker\n          volumeMounts:\n            - name: n8n-storage\n              mountPath: /home/node/.n8n\n          readinessProbe:\n            httpGet:\n              path: /healthz\n              port: 5678\n            initialDelaySeconds: 15\n            periodSeconds: 10\n            timeoutSeconds: 5\n          livenessProbe:\n            httpGet:\n              path: /healthz\n              port: 5678\n            initialDelaySeconds: 30\n            periodSeconds: 15\n            timeoutSeconds: 5\n          resources:\n            requests:\n              cpu: 250m\n              memory: 512Mi\n            limits:\n              cpu: 1000m\n              memory: 2Gi\n      volumes:\n        - name: n8n-storage\n          persistentVolumeClaim:\n            claimName: n8n-pvc\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: n8n\n  namespace: n8n\nspec:\n  ports:\n    - port: 5678\n      targetPort: 5678\n      name: http\n    - port: 5679\n      targetPort: 5679\n      name: runner-broker\n  selector:\n    app: n8n\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: n8n-runner\n  namespace: n8n\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: n8n-runner\n  template:\n    metadata:\n      labels:\n        app: n8n-runner\n    spec:\n      containers:\n        - name: runner\n          image: n8nio/runners:2.43.5\n          imagePullPolicy: IfNotPresent\n          env:\n            - name: N8N_RUNNERS_AUTH_TOKEN\n              valueFrom:\n                secretKeyRef:\n                  name: n8n-secret\n                  key: RUNNERS_AUTH_TOKEN\n            - name: N8N_RUNNERS_TASK_BROKER_URI\n              valueFrom:\n                configMapKeyRef:\n                  name: n8n-config\n                  key: N8N_RUNNERS_TASK_BROKER_URI\n          resources:\n            requests:\n              cpu: 100m\n              memory: 128Mi\n            limits:\n              cpu: 500m\n              memory: 512Mi\n```",
